# Use "local" for a zero-cost demo or "r2" for Cloudflare R2.
INSIGHTS_STORAGE_BACKEND=local
INSIGHTS_LOCAL_LAKE_PATH=data/lakehouse

# Cloudflare R2 settings. Never commit real credentials.
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
R2_BUCKET=insightsstream
